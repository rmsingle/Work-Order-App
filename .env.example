# Supabase Dashboard → Connect, or Settings → API Keys
# (older projects: Project Settings → API)
#
# EXPO_PUBLIC_SUPABASE_ANON_KEY must be the publishable key (sb_publishable_…)
# or the legacy anon key. Never put the secret key (sb_secret_…) or service_role here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
